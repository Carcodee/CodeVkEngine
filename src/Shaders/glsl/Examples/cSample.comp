#version 450

layout (set = 0, binding = 0, rgba8) uniform image2D storage_img;

layout (local_size_x = 1, local_size_y = 1, local_size_z = 1) in;

void main() {

    ivec2 xy = ivec2(gl_GlobalInvocationID.x, gl_GlobalInvocationID.y);
    float x_col = float(xy.x) / 1024.0f;
    float y_col = float(xy.y) / 1024.0f;
    imageStore(storage_img, xy, vec4(x_col, y_col, 0.0f,1.0f));
}