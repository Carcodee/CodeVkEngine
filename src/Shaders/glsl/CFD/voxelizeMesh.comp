#version 450

#extension GL_GOOGLE_include_directive : require
#extension GL_EXT_nonuniform_qualifier : enable
#extension GL_EXT_scalar_block_layout :enable
#extension GL_EXT_debug_printf : enable

#include "../Utils/uRendering.glsl"
#include "../Utils/uStructs.glsl"
#include "../Utils/uMath.glsl"
#include "../Utils/uPushConstants.glsl"


layout (set = 0, binding = 1, scalar) buffer Model_Vertices{
    U_Vertex vertex[];
};

layout (set = 0, binding = 2, scalar) buffer Model_Indices{
    uint indices[];
};
layout (set = 0, binding = 3, scalar) buffer Model_Mats{
    mat4 models[];
};
layout (set = 0, binding = 4, scalar) buffer Voxels{
    uint cells[];
};

layout(set = 0, binding = 5, scalar) uniform Model_Properties{
    uint indices_count;
    uint vertex_cunt;
    uint triangle_count;
}m_props;


layout (local_size_x = 32, local_size_y = 1, local_size_z = 1) in;
void main() {

    uint triangle_id = gl_GlobalInvocationID.x;
//    if(vertex_idx > 100000){
//        return;
//    }
    uint index_0 = indices[triangle_id * 3 + 0];
    uint index_1 = indices[triangle_id * 3 + 1];
    uint index_2 = indices[triangle_id * 3 + 2];

    U_Vertex vertex_ref_1 = vertex[index_0];
    U_Vertex vertex_ref_2 = vertex[index_1];
    U_Vertex vertex_ref = vertex[index_2];

    mat4 model = models[vertex_ref.id];
    vec4 vertex_pos_ws = model * vec4(vertex_ref.pos, 1.0);
    int collision_idx = -1;
    for(int idx = 0; idx < (voxel_grid.dimensions.x * voxel_grid.dimensions.y * voxel_grid.dimensions.z); idx++){

        uvec3 pos_in_grid = U_Linear_To_Grid_Idx(voxel_grid.dimensions, idx);
        mat4 model = U_Grid_3d_World_Pos(voxel_grid.cell_size, voxel_grid.dimensions, voxel_grid.origin, pos_in_grid);
        vec3 cell_ws_pos = vec3(model[3][0], model[3][1], model[3][2]);
        vec3 half_size = vec3(model[0][0], model[1][1], model[2][2]) / 2.0f;
        vec3 min = cell_ws_pos - half_size;
        vec3 max = cell_ws_pos + half_size;
        min = U_Min(min, max);
        max = U_Max(min, max);
        bool is_inside = U_Aabb(min, max, vec3(vertex_pos_ws.x, vertex_pos_ws.y, vertex_pos_ws.z));
        
        if(is_inside){
            collision_idx = idx;
            break;
        }
    }

    if(collision_idx > -1){
        atomicAdd(cells[collision_idx], 1);
    }

}
