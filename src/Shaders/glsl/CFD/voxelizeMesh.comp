//        p_2 = vertex_pos_ws_2.xyz - dir;
//        intersects = U_Test_Tringle_Cube(p_0, p_1, p_2, v_p_0, v_p_1, v_p_2, v_p_3, v_p_4, v_p_5, v_p_6, v_p_7);
//        if (intersects){
//            atomicAdd(cells[idx], 1);
