#version 450

#extension GL_GOOGLE_include_directive : require
#extension GL_EXT_nonuniform_qualifier : enable
#extension GL_EXT_scalar_block_layout :enable
#extension GL_EXT_debug_printf : enable

#include "../Utils/uRendering.glsl"
#include "../Utils/uStructs.glsl"
#include "../Utils/uMath.glsl"
#include "../Utils/uPushConstants.glsl"


layout (set = 0, binding = 1, scalar) buffer Model_Vertices{
    U_Vertex vertex[];
};

layout (set = 0, binding = 2, scalar) buffer Model_Indices{
    uint indices[];
};
layout (set = 0, binding = 3, scalar) buffer Model_Mats{
    mat4 models[];
};
layout (set = 0, binding = 4, scalar) buffer Voxels{
    uint cells[];
};

layout(set = 0, binding = 5, scalar) uniform Model_Properties{
    uint indices_count;
    uint vertex_cunt;
    uint triangle_count;
}m_props;


layout (local_size_x = 32, local_size_y = 1, local_size_z = 1) in;
void main() {

    uint triangle_id = gl_GlobalInvocationID.x;
    if(triangle_id >= m_props.triangle_count){
        return;
    }
    uint index_0 = indices[triangle_id * 3 + 0];
    uint index_1 = indices[triangle_id * 3 + 1];
    uint index_2 = indices[triangle_id * 3 + 2];

    U_Vertex vertex_ref_0 = vertex[index_0];
    U_Vertex vertex_ref_1 = vertex[index_1];
    U_Vertex vertex_ref_2 = vertex[index_2];

    mat4 vert_to_world_0 = models[vertex_ref_0.id];
    mat4 vert_to_world_1 = models[vertex_ref_1.id];
    mat4 vert_to_world_2 = models[vertex_ref_2.id];

    vec4 vertex_pos_ws_0 = vert_to_world_0 * vec4(vertex_ref_0.pos, 1.0);
    vec4 vertex_pos_ws_1 = vert_to_world_1 * vec4(vertex_ref_1.pos, 1.0);
    vec4 vertex_pos_ws_2 = vert_to_world_2 * vec4(vertex_ref_2.pos, 1.0);
    int collision_idx = -1;
    vec3 p_0, p_1, p_2;
    bool intersects = false;
    for(int idx = 0; idx < (voxel_grid.dimensions.x * voxel_grid.dimensions.y * voxel_grid.dimensions.z); idx++){

        //check convention with my voxel actual size vs what the function expects if lenght is 1 the function is max(|x|, |y|) = L/2
        uvec3 pos_in_grid = U_Linear_To_Grid_Idx(voxel_grid.dimensions, idx);
        mat4 voxel_to_world = U_Grid_3d_World_Pos(voxel_grid.cell_size, voxel_grid.dimensions, voxel_grid.origin, pos_in_grid);
        mat4 world_to_voxel = inverse(voxel_to_world);
        p_0 = ((world_to_voxel * vertex_pos_ws_0).xyz) / voxel_grid.cell_size;
        p_1 = ((world_to_voxel * vertex_pos_ws_1).xyz) / voxel_grid.cell_size;
        p_2 = ((world_to_voxel * vertex_pos_ws_2).xyz) / voxel_grid.cell_size;
        float t = -1;
        intersects = U_Test_Triangle_Voxel_Intersection(voxel_grid.cell_size, p_0.xyz, p_1.xyz, p_2.xyz, t);


        if(intersects){
            collision_idx = idx;
            break;
        }
    }

    if(collision_idx > -1){
        atomicAdd(cells[collision_idx], 1);
    }

}
